digraph workflow {
  graph [rankdir=TB, bgcolor="#ffffff", pad=0.25, nodesep=0.35,
         ranksep=0.45, newrank=true, compound=true, fontname="Helvetica"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11,
        color="#40566b", fillcolor="#f4f7fa", margin="0.13,0.08"];
  edge [color="#607d8b", arrowsize=0.7];

  subgraph cluster_qc {
    label="Invocation 1: public accessions to library QC";
    color="#b8c8d4";
    style="rounded";
    margin=14;

    inputs [label="Sample sheet\naccession + library + assay + context"];
    download [label="Checksummed FASTQ\ndownload"];
    reference [label="Checksummed dm6/hg38\nreference preparation", fillcolor="#eef6ff"];
    trim [label="Raw/trimmed FastQC + Cutadapt\ntrimming checkpoint"];
    align [label="Lane alignment\noptional restartable chunks\n+ library merge and duplicate mark\n+ quality filter; blacklist retained"];
    bammanifest [label="Pending final-BAM\nmanifest", fillcolor="#e5f1ff"];
    qc [label="Lenient replicate peaks + FRiP\nassay QC + MultiQC", fillcolor="#f1e9fa"];
    qccheckpoint [label="Checksummed QC checkpoint\npeak/refinement parameters", fillcolor="#f1e9fa"];
    reviewtable [label="Per-library QC\nreview table", fillcolor="#f8e8f5"];

    inputs -> download -> trim -> align;
    inputs -> reference;
    reference -> align;
    align -> bammanifest;
    align -> qc;
    qc -> qccheckpoint;
    bammanifest -> reviewtable;
    qc -> reviewtable;
    {rank=same; download; reference;}
    {rank=same; bammanifest; qccheckpoint;}
  }

  subgraph cluster_review {
    label="Explicit manual checkpoint";
    color="#d4b8ca";
    style="rounded,dashed";
    margin=14;

    review [label="User records pass/fail\nand fragment length when required", fillcolor="#f8e8f5"];
    reviewedbam [label="Reviewed final-BAM manifest\naccepted + documented rejections", fillcolor="#e5f1ff"];

    review -> reviewedbam;
  }

  subgraph cluster_master {
    label="Invocation 2: reviewed ATAC BAMs to master DHS registry";
    color="#a9ccb5";
    style="rounded";
    margin=14;

    context [label="Pooled context calls +\nreplicate-support filter", fillcolor="#dff3e5"];
    master [label="Variable-width summit-aware\nmaster DHS registry", fillcolor="#ccebd6"];
    mastermanifest [label="Checksummed master bundle\nmaster checkpoint", fillcolor="#e7f5eb"];

    context -> master -> mastermanifest;
  }

  subgraph cluster_activity {
    label="Invocation 3: accepted BAMs and frozen master to catalog, links, and report";
    color="#d9c18c";
    style="rounded";
    margin=14;

    validate [label="Validate accepted BAMs + master\nno upstream fallback", fillcolor="#eef6ff"];
    units [label="ATAC Tn5 insertions +\nH3K27ac fragments", fillcolor="#fff4d8"];
    exact [label="Exact master-interval\nraw counts + CPM/kb", fillcolor="#fff4d8"];
    background [label="10-kb autosomal\nbackground counts", fillcolor="#fff4d8"];
    windows [label="Three 500-bp max windows +\ncentered 1-kb H3K27ac window\nraw fragment counts", fillcolor="#fff4d8"];
    tmm [label="Assay-specific background TMM\nfactors", fillcolor="#fff0c7"];
    quantify [label="Normalized context signals +\nmax3, centered total, and\nnonmember-background ranks\nquantification checkpoint", fillcolor="#ffe5a8"];
    mixture [label="Guarded max3\ntwo-Gaussian fit", fillcolor="#f7e4b2"];
    catalog [label="Posterior/TSS/blacklist annotations\nlong, wide, and context catalogs", fillcolor="#f7e4b2"];
    catalogbundle [label="Checksummed completed catalog\ndownstream restart bundle", shape=note, fillcolor="#f7e4b2"];
    browser [label="Mean TMM ATAC + H3 tracks\nDHS/cCRE IGV bundles", fillcolor="#e1f0f7"];
    nearestwide [label="Default: one row per enhancer\nnearest annotated TSS ties +\ncontext promoter activity", fillcolor="#dbeedc"];
    contacts [label="Optional --with-contacts\nversioned dm6 sources\n7 observed contexts", shape=note, fillcolor="#e9f5f3"];
    normalizecontacts [label="Exact coarsening + count merge\none ICE balance per context", fillcolor="#d8eeea"];
    decay [label="Context contact decay +\natlas-wide power-law model", fillcolor="#d8eeea"];
    links [label="Optional element--promoter graph +\ncomplete gene candidates", fillcolor="#c7e5df"];
    focused [label="Enhancer posterior + contact O/E filter\nobserved-contact candidates", fillcolor="#b9ddd6"];
    nearest [label="Supplement: enhancer posterior +\nnearest active TSS per context", fillcolor="#dbeedc"];
    distancefocused [label="Enhancer posterior + active promoter\ndistance-ranked candidates\nnearest-TSS baselines", fillcolor="#b9ddd6"];
    sources [label="Frozen upstream QC\nartifacts for reporting", shape=note, fillcolor="#f3eef9"];
    report [label="Checksummed HTML/PDF/JSON\nreport checkpoint", fillcolor="#e8e1f5"];

    validate -> units;
    units -> exact;
    units -> background;
    units -> windows;
    exact -> tmm;
    background -> tmm;
    exact -> quantify;
    tmm -> quantify;
    windows -> quantify;
    quantify -> mixture -> catalog;
    units -> browser [style=dashed];
    tmm -> browser;
    catalog -> browser;
    catalog -> nearestwide;
    contacts -> normalizecontacts -> decay -> links;
    links -> focused;
    links -> nearest;
    links -> distancefocused;
    catalog -> links;
    catalogbundle -> nearestwide [style=dashed, label="restart"];
    catalogbundle -> links [style=dashed, label="optional restart"];
    browser -> report;
    nearestwide -> report;
    focused -> report;
    nearest -> report;
    distancefocused -> report;
    sources -> report [style=dashed];
    {rank=same; exact; background; windows;}
    {rank=same; browser; contacts; sources; catalogbundle;}
  }

  reviewtable -> review;
  reviewedbam -> context;
  qccheckpoint -> context;
  reviewedbam -> validate;
  mastermanifest -> validate;
  reference -> validate [style=dashed, constraint=false];
  reference -> nearestwide [style=dashed, constraint=false];
  reference -> links [style=dashed, constraint=false];
}
