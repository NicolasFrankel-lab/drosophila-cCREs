# Local environments and caches
.venv/
.micromamba/
.cluster-bootstrap/
.snakemake/
.cache/
.atlas.lock
.pytest_cache/
__pycache__/
*.py[cod]

# Runtime logs, intermediate files, and results
logs/
results/
work/
tests/workflow_results/

# Human-reviewed local artifacts and generated multi-assay run configs
data/reviewed/
/configs/*.*.dm6.yaml
/configs/*.*.hg38.yaml
/configs/drosophila-atlas.yaml
/configs/*.quantification.yaml

# Downloaded and generated reference/data assets
data/raw/
references/
*.sra
*.aria2
*.fastq
*.fastq.gz
*.fastq.gz.verified.json
*.fq
*.fq.gz
*.bam
*.bai
*.cram
*.crai
*.bt2
*.bt2l
*.bw
*.bigWig
*.bedGraph
*.bedgraph
*.bdg

# Keep deterministic small FASTQ fixtures; ignore their generated indexes.
!tests/fixtures/**/*.fastq
!tests/fixtures/**/*.fastq.gz
tests/fixtures/workflow/index/
tests/fixtures/workflow/*.fai
tests/fixtures/workflow/*.chrom.sizes
