STAGE_CHECKPOINT_ARTIFACTS = {
    "trimming": {
        "resolved_config": STAGE_RESOLVED_CONFIGS["trimming"],
        **{
            f"trimmed_fastq.{unit}": path
            for unit, path in TRIMMED_FASTQ_BY_UNIT.items()
        },
        **named_artifacts(
            [*RAW_FASTQC, *TRIMMED_FASTQC, *CUTADAPT_JSON],
            "trimming_artifact",
        ),
    },
    "alignment": {
        "resolved_config": STAGE_RESOLVED_CONFIGS["alignment"],
        **(
            {"final_bam_manifest": FINAL_BAM_EXPORT_MANIFEST}
            if FINAL_BAM_EXPORT_MANIFEST
            else {}
        ),
    },
    "qc": {
        "resolved_config": STAGE_RESOLVED_CONFIGS["qc"],
        **(
            {"final_bam_manifest": FINAL_BAM_EXPORT_MANIFEST}
            if FINAL_BAM_EXPORT_MANIFEST
            else {}
        ),
        **(
            {"library_review": LIBRARY_QC_REVIEW}
            if LIBRARY_QC_REVIEW
            else {}
        ),
        "metrics_tsv": METRICS_TSV,
        "metrics_json": METRICS_JSON,
        "multiqc_report": MULTIQC_REPORT,
        **{
            f"replicate_peak.{sample}": path
            for sample, path in PEAKS.items()
        },
        **named_artifacts(
            [
                *FRIP_TSV.values(),
                *TSS_PLOTS.values(),
                *TSS_PROFILE_TABLES.values(),
                *FRAGMENT_HISTOGRAMS.values(),
                *FINGERPRINTS.values(),
                *CROSSCORRELATION.values(),
                *CROSSCORRELATION_PLOTS.values(),
            ],
            "qc_artifact",
        ),
    },
    "master": {
        "resolved_config": STAGE_RESOLVED_CONFIGS["master"],
        **(
            {"master_manifest": MASTER_EXPORT_MANIFEST}
            if MASTER_EXPORT_MANIFEST
            else {}
        ),
    },
    "quantification": {
        "resolved_config": STAGE_RESOLVED_CONFIGS["quantification"],
        **named_artifacts(
            [*ACTIVITY_BAM_VALIDATIONS.values(), ACTIVITY_MASTER_VALIDATION],
            "input_validation",
        ),
        **{
            f"unit_bed.{library}": path
            for library, path in ACTIVITY_UNIT_BEDS.items()
        },
        **{
            f"unit_count.{library}": path
            for library, path in ACTIVITY_UNIT_COUNTS.items()
        },
        **named_artifacts(
            [
                *ACTIVITY_LIBRARY_SIGNALS.values(),
                *ACTIVITY_LIBRARY_SUMMARIES.values(),
                ACTIVITY_BACKGROUND_BINS,
                ACTIVITY_TMM_COUNTS,
                ACTIVITY_TMM_METADATA,
                ACTIVITY_TMM_FACTORS,
                ACTIVITY_TMM_RECEIPT,
                ACTIVITY_CONTEXT_SIGNAL,
                ACTIVITY_TABLE,
                ACTIVITY_METRICS,
                ACTIVITY_PROVENANCE,
                ACTIVITY_H3K27AC_WINDOWS,
                ACTIVITY_H3K27AC_WINDOWS_BED,
                *ACTIVITY_H3K27AC_WINDOW_COUNTS.values(),
                ACTIVITY_H3K27AC_SIGNAL,
                ACTIVITY_H3K27AC_METRICS,
                ACTIVITY_H3K27AC_PROVENANCE,
            ],
            "quantification_artifact",
        ),
    },
    "catalog": {
        "resolved_config": STAGE_RESOLVED_CONFIGS["catalog"],
        **named_artifacts(
            ACTIVITY_CATALOG_CHECKPOINT_FILES,
            "catalog_artifact",
        ),
    },
    "links": {
        "resolved_config": STAGE_RESOLVED_CONFIGS["links"],
        **named_artifacts(
            [
                *ACTIVITY_CATALOG_CHECKPOINT_FILES,
                NEAREST_TSS_PROMOTERS,
                NEAREST_TSS_PROMOTER_METRICS,
                NEAREST_TSS_ENHANCER_CANDIDATES,
                NEAREST_TSS_ENHANCER_METRICS,
                *(
                    [
                        CONTACT_SOURCE_MANIFEST,
                        *CONTACT_NORMALIZED.values(),
                        *CONTACT_NORMALIZED_METRICS.values(),
                        CONTACT_POWERLAW,
                        CONTACT_PROMOTERS,
                        CONTACT_PROMOTER_METRICS,
                        *CONTACT_LINK_CONTEXT_NODES.values(),
                        *CONTACT_LINK_CONTEXT_EDGES.values(),
                        *CONTACT_LINK_CONTEXT_GENES.values(),
                        *CONTACT_LINK_CONTEXT_ACTIVE_CONTACT_GENES.values(),
                        *CONTACT_LINK_CONTEXT_ACTIVE_CONTACT_METRICS.values(),
                        *CONTACT_LINK_CONTEXT_NEAREST_ACTIVE_PROMOTER_GENES.values(),
                        *CONTACT_LINK_CONTEXT_NEAREST_ACTIVE_PROMOTER_METRICS.values(),
                        *CONTACT_LINK_CONTEXT_ACTIVE_DISTANCE_GENES.values(),
                        *CONTACT_LINK_CONTEXT_ACTIVE_DISTANCE_METRICS.values(),
                        *CONTACT_LINK_CONTEXT_METRICS.values(),
                        CONTACT_LINK_METRICS,
                        CONTACT_LINK_PROVENANCE,
                    ]
                    if CONTACTS
                    else []
                ),
            ],
            "link_artifact",
        ),
    },
    "report": {
        "resolved_config": STAGE_RESOLVED_CONFIGS["report"],
        "report_html": ACTIVITY_REPORT_HTML,
        "report_pdf": ACTIVITY_REPORT_PDF,
        "report_metrics": ACTIVITY_REPORT_METRICS,
    },
}
STAGE_CHECKPOINT_PARAMETERS = {
    "assay": ASSAY,
    "atac_qpois": config.get("atac_qpois"),
    "catalog_import": CATALOG_IMPORT,
    "nearest_tss_links": NEAREST_TSS_LINKS,
    "contacts": CONTACTS,
    "peak_callers": {
        sample: SAMPLES[sample]["peak_caller"]
        for sample in TREATMENTS
    },
}

STANDARD_FINAL_TARGETS = MASTER_TARGETS
if OUTPUT_STAGE == "report":
    FINAL_TARGETS = (
        ACTIVITY_REPORT_TARGETS
        + (CONTACT_LINK_TARGETS if START_STAGE != "report" else [])
        + (
            [STAGE_CHECKPOINT_MANIFESTS["links"]]
            if START_STAGE != "report"
            else []
        )
    )
elif OUTPUT_STAGE == "links":
    FINAL_TARGETS = CONTACT_LINK_TARGETS
elif OUTPUT_STAGE == "catalog":
    FINAL_TARGETS = ACTIVITY_CATALOG_TARGETS
elif OUTPUT_STAGE == "quantification":
    FINAL_TARGETS = ACTIVITY_QUANTIFICATION_TARGETS
elif INPUT_STAGE == "master":
    FINAL_TARGETS = [
        EXTERNAL_MASTER_VALIDATION,
        MASTER_EXPORT_MANIFEST,
        RESOLVED_CONFIG,
    ]
elif OUTPUT_STAGE == "trimming":
    FINAL_TARGETS = TRIMMING_TARGETS
elif OUTPUT_STAGE == "alignment":
    FINAL_TARGETS = ALIGNMENT_TARGETS
elif OUTPUT_STAGE == "qc":
    FINAL_TARGETS = QC_TARGETS
else:
    FINAL_TARGETS = MASTER_TARGETS
FINAL_TARGETS = [
    *FINAL_TARGETS,
    STAGE_CHECKPOINT_MANIFESTS[OUTPUT_STAGE],
]


include: "rules/common.smk"


rule all:
    input:
        FINAL_TARGETS


