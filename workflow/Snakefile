"""Accession-resolved ATAC-seq and ChIP-seq processing workflow."""

import json
import sys
from pathlib import Path
import shlex
from urllib.parse import urlparse


REPO_ROOT = Path(workflow.basedir).parent.resolve()
sys.path.insert(0, str(REPO_ROOT / "src"))

from short_read_processing.consensus import condition_specs
from short_read_processing.artifacts import FINAL_BAM_FILTERING_CONTRACT
from short_read_processing.activity_tmm import (
    TMM_BACKGROUND_METHOD,
)
from short_read_processing.workflow_config import (
    aria2_checksum,
    guard_result_namespace,
    named_artifacts,
    resolve_input_paths,
    validate_stage_selection,
    validate_workflow_config,
    wildcard_regex,
)
from short_read_processing.contact_metadata import read_contact_source_manifest


if not config:
    raise ValueError("Pass a resolved YAML with --configfile")
validate_workflow_config(config)
resolve_input_paths(config, Path.cwd())

PROJECT = str(config["project"])
RUN_ID = str(config["run_id"])
ASSAY = str(config["assay"])
INPUT_STAGE = str(config.get("input_stage", "accessions"))
START_STAGE = str(config.get("start_stage", INPUT_STAGE))
OUTPUT_STAGE = validate_stage_selection(START_STAGE, config.get("output_stage"))
ACTIVITY = config.get("activity")
CATALOG_IMPORT = config.get("catalog_import")
EXECUTION = config.get("execution", {})
ALIGNMENT_CHUNK_PAIRS = int(EXECUTION.get("alignment_chunk_pairs", 0))
CHUNKED_ALIGNMENT_ENABLED = ALIGNMENT_CHUNK_PAIRS > 0
RESULT_ROOT = str(Path(config["output_dir"]) / PROJECT / RUN_ID)
WORK_ROOT = str(Path("work") / PROJECT / RUN_ID)
RESOLVED_CONFIG = f"{RESULT_ROOT}/provenance/resolved_config.json"
guard_result_namespace(
    config,
    Path(RESULT_ROOT) / "provenance" / "resolved_config.json",
)
SAMPLES = {str(sample["id"]): sample for sample in config["samples"]}
SAMPLE_IDS = list(SAMPLES)
BUILD_SAMPLE_IDS = [
    sample for sample in SAMPLE_IDS if "final_bam" not in SAMPLES[sample]
]
EXTERNAL_BAM_SAMPLES = [
    sample for sample in SAMPLE_IDS if "final_bam" in SAMPLES[sample]
]
EXTERNAL_QC_PEAK_SAMPLES = [
    sample for sample in SAMPLE_IDS if "qc_peak" in SAMPLES[sample]
]
TREATMENTS = [sample for sample in SAMPLE_IDS if SAMPLES[sample]["role"] == "treatment"]
CHIP_TREATMENTS = TREATMENTS if ASSAY.startswith("chip") else []
CHIP_CONTROLLED_TREATMENTS = [
    sample for sample in CHIP_TREATMENTS if SAMPLES[sample].get("control")
]
ATAC_SAMPLES = TREATMENTS if ASSAY == "atac" else []
ATAC_QPOIS_SAMPLES = list(ATAC_SAMPLES)
ATAC_QPOIS_PE_SAMPLES = [
    sample for sample in ATAC_QPOIS_SAMPLES if SAMPLES[sample]["layout"] == "paired"
]

ATAC_QPOIS = config.get(
    "atac_qpois",
    {
        "fragment_maximum": 150,
        "minimum_exponent": 2,
        "maximum_exponent": 325,
        "merge_gap": 1,
        "minimum_length": 50,
        "maximum_length": 400,
    },
)
ATAC_CONSENSUS = config.get("atac_consensus", {"enabled": False})
ATAC_CONSENSUS_ENABLED = bool(ATAC_CONSENSUS.get("enabled"))
EXTERNAL_MASTER = config.get("external_master")
ATAC_MASTER = config.get(
    "atac_master",
    {"summit_max_distance": 150, "minimum_summit_separation": 50},
)
ATAC_MASTER_BUILD_ENABLED = ATAC_CONSENSUS_ENABLED and EXTERNAL_MASTER is None
ATAC_MASTER_ENABLED = ATAC_MASTER_BUILD_ENABLED or EXTERNAL_MASTER is not None
ATAC_CONDITION_SPECS = (
    condition_specs(
        ATAC_CONSENSUS["conditions"],
        sample_ids=ATAC_SAMPLES,
        minimum_replicates=int(ATAC_CONSENSUS["minimum_replicates"]),
    )
    if ATAC_CONSENSUS_ENABLED
    else []
)
ATAC_CONDITIONS = {spec.condition_id: spec for spec in ATAC_CONDITION_SPECS}
for condition, specification in ATAC_CONDITIONS.items():
    layouts = {SAMPLES[sample]["layout"] for sample in specification.samples}
    if len(layouts) != 1:
        raise ValueError(f"ATAC condition {condition} mixes read layouts")
    parameters = {
        (
            SAMPLES[sample]["peak_caller"]["qvalue"],
            SAMPLES[sample]["peak_caller"]["shift"],
            SAMPLES[sample]["peak_caller"]["extsize"],
        )
        for sample in specification.samples
    }
    if len(parameters) != 1:
        raise ValueError(f"ATAC condition {condition} mixes MACS3 parameters")
ATAC_CONDITION_IDS = list(ATAC_CONDITIONS)
ATAC_QPOIS_CONDITIONS = list(ATAC_CONDITION_IDS)

SAMPLE_RE = wildcard_regex(SAMPLE_IDS)
BUILD_SAMPLE_RE = wildcard_regex(BUILD_SAMPLE_IDS)
EXTERNAL_BAM_SAMPLE_RE = wildcard_regex(EXTERNAL_BAM_SAMPLES)
EXTERNAL_QC_PEAK_SAMPLE_RE = wildcard_regex(EXTERNAL_QC_PEAK_SAMPLES)
ATAC_RE = wildcard_regex(ATAC_SAMPLES)
ATAC_QPOIS_RE = wildcard_regex(ATAC_QPOIS_SAMPLES)
ATAC_QPOIS_PE_RE = wildcard_regex(ATAC_QPOIS_PE_SAMPLES)
ATAC_CONDITION_RE = wildcard_regex(ATAC_CONDITION_IDS)
ATAC_QPOIS_CONDITION_RE = wildcard_regex(ATAC_QPOIS_CONDITIONS)
CHIP_TREATMENT_RE = wildcard_regex(CHIP_TREATMENTS)
CHIP_CONTROLLED_TREATMENT_RE = wildcard_regex(CHIP_CONTROLLED_TREATMENTS)

LANES = {}
RAW_FASTQ_BY_UNIT = {}
TRIMMED_FASTQ_BY_UNIT = {}
for sample_id, sample in SAMPLES.items():
    if sample_id not in BUILD_SAMPLE_IDS:
        continue
    for index, r1 in enumerate(sample["r1"], start=1):
        lane = f"L{index:03d}"
        key = (sample_id, lane)
        LANES[key] = {"r1": r1, "r2": None}
        RAW_FASTQ_BY_UNIT[f"{sample_id}.{lane}.R1"] = r1
        if sample["layout"] == "paired":
            r2 = sample["r2"][index - 1]
            LANES[key]["r2"] = r2
            RAW_FASTQ_BY_UNIT[f"{sample_id}.{lane}.R2"] = r2

PE_LANES = [key for key in LANES if SAMPLES[key[0]]["layout"] == "paired"]
SE_LANES = [key for key in LANES if SAMPLES[key[0]]["layout"] == "single"]
PE_SAMPLE_RE = wildcard_regex(sorted({sample for sample, _lane in PE_LANES}))
SE_SAMPLE_RE = wildcard_regex(sorted({sample for sample, _lane in SE_LANES}))
LANE_RE = wildcard_regex(sorted({lane for _sample, lane in LANES}))

TRIMMED_R1 = {}
TRIMMED_R2 = {}
for sample_id, lane in LANES:
    suffix = "R1" if SAMPLES[sample_id]["layout"] == "paired" else "SE"
    r1_path = f"{WORK_ROOT}/trimmed/{sample_id}/{lane}_{suffix}.fastq.gz"
    TRIMMED_R1[(sample_id, lane)] = r1_path
    TRIMMED_FASTQ_BY_UNIT[f"{sample_id}.{lane}.R1"] = r1_path
    if SAMPLES[sample_id]["layout"] == "paired":
        r2_path = f"{WORK_ROOT}/trimmed/{sample_id}/{lane}_R2.fastq.gz"
        TRIMMED_R2[(sample_id, lane)] = r2_path
        TRIMMED_FASTQ_BY_UNIT[f"{sample_id}.{lane}.R2"] = r2_path

LANE_BAMS = {
    key: f"{WORK_ROOT}/alignment/lanes/{key[0]}.{key[1]}.coordsort.bam" for key in LANES
}
LANE_BY_UNIT = {f"{sample}.{lane}": (sample, lane) for sample, lane in LANES}
CHUNK_ALIGNMENT_UNITS = (
    [
        unit
        for unit, key in LANE_BY_UNIT.items()
        if not Path(LANE_BAMS[key]).is_file()
    ]
    if CHUNKED_ALIGNMENT_ENABLED
    else []
)
CHUNK_ALIGNMENT_UNIT_RE = wildcard_regex(CHUNK_ALIGNMENT_UNITS)
ALIGNMENT_CHUNK_RE = r"chunk[0-9]{6}"
ALIGNMENT_CHUNK_ROOT = (
    f"{WORK_ROOT}/alignment/chunks/pairs-{ALIGNMENT_CHUNK_PAIRS}"
)

REFERENCE = config["reference"]
REFERENCE_PREPARATION = REFERENCE.get("preparation")
AUTO_PREPARE_REFERENCE = bool(
    REFERENCE_PREPARATION and REFERENCE_PREPARATION.get("mode") == "download"
)
REFERENCE_SOURCE_DIR = Path(REFERENCE["fasta"]).parent / "sources"
if AUTO_PREPARE_REFERENCE:
    REFERENCE_FASTA_ARCHIVE = str(
        REFERENCE_SOURCE_DIR
        / Path(urlparse(REFERENCE_PREPARATION["fasta"]["url"]).path).name
    )
    REFERENCE_ANNOTATION_ARCHIVE = str(
        REFERENCE_SOURCE_DIR
        / Path(urlparse(REFERENCE_PREPARATION["annotation"]["url"]).path).name
    )
    REFERENCE_BLACKLIST_ARCHIVE = str(
        REFERENCE_SOURCE_DIR
        / Path(urlparse(REFERENCE_PREPARATION["blacklist"]["url"]).path).name
    )
BT2_PREFIX = str(REFERENCE["bowtie2_index"])
BT2_SUFFIXES = [".1.bt2", ".2.bt2", ".3.bt2", ".4.bt2", ".rev.1.bt2", ".rev.2.bt2"]
BT2_INDEX = [BT2_PREFIX + suffix for suffix in BT2_SUFFIXES]
FASTA_INDEX = str(REFERENCE["fasta"]) + ".fai"

FINAL_BAMS = {
    sample: (
        str(SAMPLES[sample]["final_bam"]["bam"])
        if sample in EXTERNAL_BAM_SAMPLES
        else f"{RESULT_ROOT}/bam/{sample}.final.bam"
    )
    for sample in SAMPLE_IDS
}
FINAL_BAIS = {
    sample: (
        str(SAMPLES[sample]["final_bam"]["bai"])
        if sample in EXTERNAL_BAM_SAMPLES
        else FINAL_BAMS[sample] + ".bai"
    )
    for sample in SAMPLE_IDS
}
EXTERNAL_BAM_VALIDATIONS = {
    sample: f"{RESULT_ROOT}/provenance/external_bams/{sample}.validated.json"
    for sample in EXTERNAL_BAM_SAMPLES
}
ATAC_SHIFTED_BIGWIGS = {
    sample: f"{RESULT_ROOT}/tracks/{sample}.Tn5-shifted.CPM.bw" for sample in ATAC_SAMPLES
}

ATAC_ROOT = f"{RESULT_ROOT}/atac"
ATAC_WORK = f"{WORK_ROOT}/atac"
ATAC_FRAGMENT_MAXIMUM = int(ATAC_QPOIS["fragment_maximum"])
ATAC_SHORT_BAMS = {
    sample: f"{ATAC_WORK}/replicates/{sample}.fragments-lt{ATAC_FRAGMENT_MAXIMUM}.bam"
    for sample in ATAC_QPOIS_PE_SAMPLES
}
ATAC_SHORT_BAIS = {sample: ATAC_SHORT_BAMS[sample] + ".bai" for sample in ATAC_QPOIS_PE_SAMPLES}
ATAC_INSERTIONS = {
    sample: f"{ATAC_WORK}/replicates/{sample}.tn5-insertions.bed.gz"
    for sample in ATAC_QPOIS_SAMPLES
}
ATAC_INSERTION_COUNTS = {
    sample: f"{ATAC_WORK}/replicates/{sample}.tn5-insertions.count.txt"
    for sample in ATAC_QPOIS_SAMPLES
}
ATAC_REPLICATE_CANDIDATES = {
    sample: f"{ATAC_WORK}/replicates/{sample}/peaks/{sample}.candidates.narrowPeak"
    for sample in ATAC_QPOIS_SAMPLES
}
ATAC_REPLICATE_PILEUP_BDG = {
    sample: f"{ATAC_WORK}/replicates/{sample}.pileup.bdg" for sample in ATAC_QPOIS_SAMPLES
}
ATAC_REPLICATE_LAMBDA_BDG = {
    sample: f"{ATAC_WORK}/replicates/{sample}.lambda.bdg" for sample in ATAC_QPOIS_SAMPLES
}
ATAC_REPLICATE_QPOIS_BDG = {
    sample: f"{ATAC_WORK}/replicates/{sample}.qpois.bdg" for sample in ATAC_QPOIS_SAMPLES
}
ATAC_REPLICATE_REFINED = {
    sample: (
        str(SAMPLES[sample]["qc_peak"]["path"])
        if sample in EXTERNAL_QC_PEAK_SAMPLES
        else f"{ATAC_ROOT}/replicates/{sample}/peaks/{sample}.qpois-refined.bed"
    )
    for sample in ATAC_QPOIS_SAMPLES
}
ATAC_REPLICATE_EXCLUDED = {
    sample: f"{ATAC_ROOT}/replicates/{sample}/peaks/{sample}.qpois-excluded.bed"
    for sample in ATAC_QPOIS_SAMPLES
}
ATAC_REPLICATE_STATS = {
    sample: f"{ATAC_ROOT}/replicates/{sample}/peaks/{sample}.qpois-refinement.json"
    for sample in ATAC_QPOIS_SAMPLES
}
EXTERNAL_QC_PEAK_VALIDATIONS = {
    sample: f"{RESULT_ROOT}/provenance/external_qc_peaks/{sample}.validated.json"
    for sample in EXTERNAL_QC_PEAK_SAMPLES
}

ATAC_CONDITION_INSERTIONS = {
    condition: f"{ATAC_WORK}/conditions/{condition}.tn5-insertions.bed.gz"
    for condition in ATAC_QPOIS_CONDITIONS
}
ATAC_CONDITION_INSERTION_COUNTS = {
    condition: f"{ATAC_WORK}/conditions/{condition}.tn5-insertions.count.txt"
    for condition in ATAC_QPOIS_CONDITIONS
}
ATAC_CONDITION_CANDIDATES = {
    condition: f"{ATAC_ROOT}/conditions/{condition}/peaks/{condition}.candidates.narrowPeak"
    for condition in ATAC_QPOIS_CONDITIONS
}
ATAC_CONDITION_PILEUP_BDG = {
    condition: f"{ATAC_WORK}/conditions/{condition}.pileup.bdg"
    for condition in ATAC_QPOIS_CONDITIONS
}
ATAC_CONDITION_LAMBDA_BDG = {
    condition: f"{ATAC_WORK}/conditions/{condition}.lambda.bdg"
    for condition in ATAC_QPOIS_CONDITIONS
}
ATAC_CONDITION_QPOIS_BDG = {
    condition: f"{ATAC_WORK}/conditions/{condition}.qpois.bdg"
    for condition in ATAC_QPOIS_CONDITIONS
}
ATAC_CONDITION_REFINED = {
    condition: f"{ATAC_ROOT}/conditions/{condition}/peaks/{condition}.qpois-refined.bed"
    for condition in ATAC_QPOIS_CONDITIONS
}
ATAC_CONDITION_EXCLUDED = {
    condition: f"{ATAC_ROOT}/conditions/{condition}/peaks/{condition}.qpois-excluded.bed"
    for condition in ATAC_QPOIS_CONDITIONS
}
ATAC_CONDITION_REFINEMENT_STATS = {
    condition: f"{ATAC_ROOT}/conditions/{condition}/peaks/{condition}.qpois-refinement.json"
    for condition in ATAC_QPOIS_CONDITIONS
}
ATAC_CONDITION_PILEUP_BW = {
    condition: f"{ATAC_ROOT}/conditions/{condition}/tracks/{condition}.MACS3-pileup.unscaled.bw"
    for condition in ATAC_QPOIS_CONDITIONS
}
ATAC_CONDITION_QPOIS_BW = {
    condition: f"{ATAC_ROOT}/conditions/{condition}/tracks/{condition}.qpois.bw"
    for condition in ATAC_QPOIS_CONDITIONS
}
ATAC_CONDITION_CONSENSUS = {
    condition: f"{ATAC_ROOT}/conditions/{condition}/peaks/{condition}.replicate-supported.bed"
    for condition in ATAC_CONDITION_IDS
}
ATAC_CONDITION_SUPPORT = {
    condition: f"{ATAC_ROOT}/conditions/{condition}/peaks/{condition}.replicate-support.tsv"
    for condition in ATAC_CONDITION_IDS
}
ATAC_CONDITION_STATS = {
    condition: f"{ATAC_ROOT}/conditions/{condition}/peaks/{condition}.replicate-support.json"
    for condition in ATAC_CONDITION_IDS
}
ATAC_CONDITION_SIGNAL_BW = dict(ATAC_CONDITION_PILEUP_BW)
ATAC_MASTER_ROOT = f"{ATAC_ROOT}/master"
ATAC_MASTER_BED = (
    str(EXTERNAL_MASTER["master_bed"])
    if EXTERNAL_MASTER
    else f"{ATAC_MASTER_ROOT}/master_dhs.bed"
)
ATAC_MASTER_SUMMITS = (
    str(EXTERNAL_MASTER["summits_bed"])
    if EXTERNAL_MASTER
    else f"{ATAC_MASTER_ROOT}/master_dhs_summits.bed"
)
ATAC_MASTER_MEMBERSHIP = (
    str(EXTERNAL_MASTER["membership_tsv"])
    if EXTERNAL_MASTER
    else f"{ATAC_MASTER_ROOT}/master_dhs_membership.tsv"
)
ATAC_MASTER_CONTEXT_MATRIX = (
    str(EXTERNAL_MASTER["context_matrix_tsv"])
    if EXTERNAL_MASTER
    else f"{ATAC_MASTER_ROOT}/master_dhs_context_matrix.tsv"
)
ATAC_MASTER_STATS = (
    str(EXTERNAL_MASTER["stats_json"])
    if EXTERNAL_MASTER
    else f"{ATAC_MASTER_ROOT}/master_dhs.json"
)
EXTERNAL_MASTER_VALIDATION = (
    f"{RESULT_ROOT}/provenance/external_master.validated.json"
    if EXTERNAL_MASTER
    else None
)
FINAL_BAM_EXPORT_MANIFEST = (
    f"{RESULT_ROOT}/provenance/manifests/final-bams.tsv"
    if SAMPLE_IDS
    else None
)
MASTER_EXPORT_MANIFEST = (
    f"{RESULT_ROOT}/provenance/manifests/master-dhs.tsv"
    if ATAC_MASTER_ENABLED
    else None
)
FINAL_BAM_EXPORT_ROWS = []
for sample in SAMPLE_IDS:
    external = SAMPLES[sample].get("final_bam")
    row = {
        "library_id": sample,
        "assay": ASSAY,
        "context": str(SAMPLES[sample]["context"]),
        "role": str(SAMPLES[sample]["role"]),
        "layout": str(SAMPLES[sample]["layout"]),
        "bam": FINAL_BAMS[sample],
        "bai": FINAL_BAIS[sample],
        "genome": str(REFERENCE["name"]),
        "filtering_contract": FINAL_BAM_FILTERING_CONTRACT,
        "qc_status": (
            str(external["qc_status"]) if external else "pending_review"
        ),
        "estimated_fragment_length_bp": (
            str(external.get("estimated_fragment_length_bp", ""))
            if external
            else ""
        ),
        "source_project": (
            str(external.get("source_project", "")) if external else PROJECT
        ),
        "source_run_id": (
            str(external.get("source_run_id", "")) if external else RUN_ID
        ),
        "notes": (
            "validated external final BAM"
            if external
            else "automatically exported pipeline final BAM; scientific QC pending"
        ),
    }
    if external:
        row["bam_sha256"] = str(external["bam_sha256"])
        row["bai_sha256"] = str(external["bai_sha256"])
    FINAL_BAM_EXPORT_ROWS.append(row)

MASTER_EXPORT_METADATA = (
    {
        "genome": str(REFERENCE["name"]),
        "method": (
            str(EXTERNAL_MASTER["method"])
            if EXTERNAL_MASTER
            else "reciprocal_summit_complete_linkage_v2"
        ),
        "input_filtering_contract": (
            str(EXTERNAL_MASTER["input_filtering_contract"])
            if EXTERNAL_MASTER
            else FINAL_BAM_FILTERING_CONTRACT
        ),
        "source_project": (
            str(EXTERNAL_MASTER["source_project"])
            if EXTERNAL_MASTER
            else PROJECT
        ),
        "source_run_id": (
            str(EXTERNAL_MASTER["source_run_id"])
            if EXTERNAL_MASTER
            else RUN_ID
        ),
        **(
            {
                f"{field}_sha256": str(EXTERNAL_MASTER[f"{field}_sha256"])
                for field in (
                    "master_bed",
                    "summits_bed",
                    "membership_tsv",
                    "context_matrix_tsv",
                    "stats_json",
                )
            }
            if EXTERNAL_MASTER
            else {}
        ),
    }
    if ATAC_MASTER_ENABLED
    else None
)
ATAC_MASTER_TARGETS = (
    [
        ATAC_MASTER_BED,
        ATAC_MASTER_SUMMITS,
        ATAC_MASTER_MEMBERSHIP,
        ATAC_MASTER_CONTEXT_MATRIX,
        ATAC_MASTER_STATS,
    ]
    if ATAC_MASTER_BUILD_ENABLED
    else [EXTERNAL_MASTER_VALIDATION]
    if EXTERNAL_MASTER
    else []
)

ACTIVITY_ROOT = f"{RESULT_ROOT}/activity"
ACTIVITY_WORK = f"{WORK_ROOT}/activity"
ACTIVITY_QUANTIFICATION_ROOT = f"{ACTIVITY_ROOT}/quantification"
ACTIVITY_LIBRARIES = (
    {str(library["id"]): library for library in ACTIVITY["libraries"]}
    if ACTIVITY
    else {}
)
ACTIVITY_LIBRARY_IDS = list(ACTIVITY_LIBRARIES)
ACTIVITY_ATAC_LIBRARIES = [
    library
    for library in ACTIVITY_LIBRARY_IDS
    if ACTIVITY_LIBRARIES[library]["assay"] == "atac"
]
ACTIVITY_H3K27AC_LIBRARIES = [
    library
    for library in ACTIVITY_LIBRARY_IDS
    if ACTIVITY_LIBRARIES[library]["assay"] == "h3k27ac"
]
ACTIVITY_H3K27AC_PAIRED_LIBRARIES = [
    library
    for library in ACTIVITY_H3K27AC_LIBRARIES
    if ACTIVITY_LIBRARIES[library]["layout"] == "paired"
]
ACTIVITY_H3K27AC_SINGLE_LIBRARIES = [
    library
    for library in ACTIVITY_H3K27AC_LIBRARIES
    if ACTIVITY_LIBRARIES[library]["layout"] == "single"
]
ACTIVITY_LIBRARY_RE = wildcard_regex(ACTIVITY_LIBRARY_IDS)
ACTIVITY_ATAC_LIBRARY_RE = wildcard_regex(ACTIVITY_ATAC_LIBRARIES)
ACTIVITY_H3K27AC_PAIRED_LIBRARY_RE = wildcard_regex(
    ACTIVITY_H3K27AC_PAIRED_LIBRARIES
)
ACTIVITY_H3K27AC_SINGLE_LIBRARY_RE = wildcard_regex(
    ACTIVITY_H3K27AC_SINGLE_LIBRARIES
)
ACTIVITY_BAM_VALIDATIONS = {
    library: f"{RESULT_ROOT}/provenance/activity/bams/{library}.validated.json"
    for library in ACTIVITY_LIBRARY_IDS
}
ACTIVITY_MASTER_VALIDATION = (
    f"{RESULT_ROOT}/provenance/activity/master.validated.json"
    if ACTIVITY
    else None
)
ACTIVITY_UNIT_BEDS = {
    library: f"{ACTIVITY_QUANTIFICATION_ROOT}/units/{library}.bed.gz"
    for library in ACTIVITY_LIBRARY_IDS
}
ACTIVITY_UNIT_COUNTS = {
    library: f"{ACTIVITY_QUANTIFICATION_ROOT}/units/{library}.count.txt"
    for library in ACTIVITY_LIBRARY_IDS
}
ACTIVITY_LIBRARY_SIGNALS = {
    library: f"{ACTIVITY_QUANTIFICATION_ROOT}/libraries/{library}.signal.tsv.gz"
    for library in ACTIVITY_LIBRARY_IDS
}
ACTIVITY_LIBRARY_SUMMARIES = {
    library: f"{ACTIVITY_QUANTIFICATION_ROOT}/libraries/{library}.summary.json"
